# Copy to .env and fill. Never commit .env.
# Prefer UI: jarvis serve →「設定」→ %APPDATA%\Jarvis\settings.json (overrides .env).

# ASR: sensevoice (local) | openai_audio (cloud chat+input_audio, e.g. MiMo)
# JARVIS_ASR_PROVIDER=sensevoice
# JARVIS_ASR_API_KEY=
# JARVIS_ASR_BASE_URL=https://api.xiaomimimo.com/v1
# JARVIS_ASR_MODEL=mimo-v2.5-asr
# Legacy aliases:
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# LLM — any OpenAI-compatible endpoint (DeepSeek / MiMo / Ollama / custom)
# Ollama example: JARVIS_LLM_BASE_URL=http://127.0.0.1:11434/v1  JARVIS_LLM_API_KEY=ollama
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.deepseek.com
JARVIS_LLM_MODEL=deepseek-chat
# OPENAI_API_KEY=
