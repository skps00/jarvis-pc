# Copy to .env and fill. Never commit .env.

# Google Cloud STT (legacy; project uses SenseVoice locally)
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Intent / query LLM — OpenAI-compatible (default DeepSeek)
# GLM: set BASE_URL to智譜 OpenAI-compat endpoint + glm-4-flash model
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.deepseek.com
JARVIS_LLM_MODEL=deepseek-chat
# Alias if JARVIS_LLM_API_KEY empty:
# OPENAI_API_KEY=
